{
  "name": "udyam-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,green \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "seed": "npm run seed --workspace=backend",
    "seed:verify": "npm run seed:verify --workspace=backend",
    "test": "npm run test --workspace=frontend --workspace=backend",
    "test:advisor": "npm run test:advisor --workspace=backend",
    "test:business": "node scripts/check-business-claims.js",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext js,jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "mongodb-memory-server@10.4.3": true,
    "sharp@0.33.5": true,
    "tesseract.js@5.1.1": true,
    "express-rate-limit@7.5.1": true
  }
}
