# Udyam One - Environment Variables
# Copy to .env and fill in required values

# === Core ===
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# === Database ===
# Single-node replica set required for transactions
MONGO_URI=mongodb://localhost:27017/udyam?replicaSet=rs0&directConnection=true

# === Authentication ===
# Minimum 32 characters each
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# === OTP ===
# simulated: codes appear in dev outbox only
OTP_MODE=simulated

# === LLM Provider ===
# mock: deterministic offline provider (default)
# anthropic: requires ANTHROPIC_API_KEY
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_MS=12000

# === Pricing ===
# min | mid | max — uses catalogue minimum by default
PRICING_MODE=min
# Segments that can self-serve (others get indicative quote + partner handoff)
SELF_SERVE_SEGMENTS=prof,micro

# === KYC ===
KYC_REFERENCE_DATE=2026-07-15
KYC_ADDRESS_PROOF_MAX_DAYS=90

# === File Storage ===
# 32-byte key, base64-encoded, for AES-256-GCM encryption at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENC_KEY=
UPLOAD_MAX_BYTES=5242880

# === Data Retention ===
RETENTION_REJECTED_DAYS=30
RETENTION_APPROVED_DAYS=180

# === Simulation ===
# Minutes of real time per simulated day for the tracker
SIM_TIME_SCALE=1
QUOTE_TTL_DAYS=7

# === Demo ===
# Password for seeded staff accounts (demo only)
STAFF_SEED_PASSWORD=DemoPassword123!
# Enable demo mode (synthetic accounts, reset, prefilled personas)
DEMO_MODE=false

# === Feature Flags ===
# Stubs only; documented as future work
FEATURE_VOICE=false
FEATURE_WHATSAPP=false
