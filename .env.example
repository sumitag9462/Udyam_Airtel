# Udyam One - Environment Variables
# Copy to .env and fill in required values

# === Core ===
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# === Database ===
# Local single-node or replica set:
MONGO_URI=mongodb://127.0.0.1:27017/udyam_one
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/udyam_one?retryWrites=true&w=majority

# === Authentication ===
# Minimum 32 characters each
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# === OTP ===
# simulated: codes appear in dev outbox only
OTP_MODE=simulated

# === OCR Provider ===
# mock: deterministic simulated extraction; tesseract: local OCR engine
OCR_PROVIDER=mock

# === LLM Provider ===
# mock: deterministic offline provider (default)
# anthropic: requires ANTHROPIC_API_KEY
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_MS=12000

# === Pricing ===
# min | mid | max — uses catalogue minimum by default
PRICING_MODE=min
# Segments that can self-serve (others get indicative quote + partner handoff)
SELF_SERVE_SEGMENTS=prof,micro

# === KYC ===
KYC_REFERENCE_DATE=2026-07-15
KYC_ADDRESS_PROOF_MAX_DAYS=90

# === File Storage ===
# 32-byte key, base64-encoded, for AES-256-GCM encryption at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENC_KEY=9GqoIJG6szGdKWhh+/ex0hvJN34j4P455jphaJ+QkA0=
UPLOAD_MAX_BYTES=5242880

# === Data Retention ===
RETENTION_REJECTED_DAYS=30
RETENTION_APPROVED_DAYS=180

# === Simulation ===
# Minutes of real time per simulated day for the tracker
SIM_TIME_SCALE=1
QUOTE_TTL_DAYS=7

# === Demo ===
# Password for seeded staff accounts (demo only)
STAFF_SEED_PASSWORD=DemoPassword123!
# Enable demo mode (synthetic accounts, reset, prefilled personas)
DEMO_MODE=false

# === Feature Flags ===
# Stubs only; documented as future work
FEATURE_VOICE=false
FEATURE_WHATSAPP=false
