# Udyam One — Frontend Environment Configuration
# Copy this file to .env for local development

# API Base URL path or full URL.
# Uses same-origin /api proxy for local development (Vite proxies /api requests to backend at http://127.0.0.1:3001)
VITE_API_BASE_URL=/api/v1

# Alternative direct backend URL (used if bypassing Vite proxy or deploying frontend independently):
# VITE_API_URL=http://localhost:3001/api/v1
