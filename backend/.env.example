# Udyam One — Backend Environment Configuration
# Copy to .env and configure for local development

NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Native MongoDB or MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/udyam_one
# Atlas example: MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/udyam_one?retryWrites=true&w=majority

# Authentication Secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# OTP Delivery Mode (simulated: outbox/console display only)
OTP_MODE=simulated

# LLM Provider (mock: deterministic offline rules; anthropic: external Claude API)
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_MS=12000

# Pricing Mode (min | mid | max)
PRICING_MODE=min
SELF_SERVE_SEGMENTS=prof,micro

# KYC Compliance & Verification Dates
KYC_REFERENCE_DATE=2026-07-15
KYC_ADDRESS_PROOF_MAX_DAYS=90

# Document Storage & Authenticated Encryption at Rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENC_KEY=9GqoIJG6szGdKWhh+/ex0hvJN34j4P455jphaJ+QkA0=
UPLOAD_MAX_BYTES=5242880

# DPDP Act 2023 Retention Policies (in days)
RETENTION_REJECTED_DAYS=30
RETENTION_APPROVED_DAYS=180

# Simulation Configuration
SIM_TIME_SCALE=1
QUOTE_TTL_DAYS=7

# Demo Accounts
STAFF_SEED_PASSWORD=DemoPassword123!
DEMO_MODE=false

# Feature Flags
FEATURE_VOICE=false
FEATURE_WHATSAPP=false
